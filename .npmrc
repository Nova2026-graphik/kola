# Metro (React Native) ne suit pas les liens symboliques de pnpm de façon fiable.
# Le linker « hoisted » produit un node_modules classique, seul mode supporté par Expo en monorepo.
node-linker=hoisted

# Les paquets Expo / React Native déclarent mal leurs peer dependencies ; sans cela
# l'installation échoue sur des conflits qui n'en sont pas.
strict-peer-dependencies=false
auto-install-peers=true
